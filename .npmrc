# vite-plugin-electron@1.1.2 declares a peerDependency of vite >=6, but the project is
# intentionally pinned to vite ^5.4.21 (matching vitest 2.x / @vitejs/plugin-react 4.x) and the
# plugin works correctly against it in practice — this is a stale peer range in the plugin's own
# metadata, not a real incompatibility. Without this, plain `npm ci` fails in CI before anything
# else runs. Needed on every platform the workflow builds on (ubuntu/macos/windows).
legacy-peer-deps=true
