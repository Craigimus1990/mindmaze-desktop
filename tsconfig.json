// No tsconfig.node.json: `include` below covers vite.config.ts and vitest.config.ts directly,
// which is what actually typechecks them (verified — removing a separate node config left
// coverage unchanged at 2/2). A referenced project would be the alternative; a file that is
// present but inert is worse than neither, so there is deliberately none.
{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "types": ["vite/client"]
  },
  "include": ["src", "electron", "tests", "vite.config.ts", "vitest.config.ts"]
}
